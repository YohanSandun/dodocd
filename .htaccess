RewriteEngine On

# Pass the Authorization header through to PHP; CGI/FastCGI setups drop it otherwise.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Code, config and data are never served directly; only index.php runs.
RewriteRule ^(agent|storage)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
